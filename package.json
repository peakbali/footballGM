{
  "name": "footballgm",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "vite build --mode single",
    "build:play": "tsc && vite build --mode play",
    "test": "vitest run",
    "typecheck": "tsc",
    "sim": "tsx scripts/simulate.ts",
    "cap:sync": "npm run build && npx cap sync"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peakbali/footballGM.git"
  },
  "bugs": {
    "url": "https://github.com/peakbali/footballGM/issues"
  },
  "homepage": "https://github.com/peakbali/footballGM#readme",
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "preact": "^11.2.0",
    "sql.js": "^1.17.0"
  },
  "private": true,
  "type": "module"
}
